{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/dev-james0723/agent-pooper-scooper/docs/schemas/manifest.v1.schema.json",
  "title": "agent-pooper-scooper/manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "schema_version",
    "task_id",
    "host",
    "producer",
    "created_at",
    "updated_at",
    "roots",
    "artifacts"
  ],
  "properties": {
    "schema": {
      "const": "agent-pooper-scooper/manifest"
    },
    "schema_version": {
      "const": 1
    },
    "task_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@+-]{0,127}$"
    },
    "host": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9.-]{0,252}$"
    },
    "producer": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@+-]{0,127}$"
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,6})?Z$"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,6})?Z$"
    },
    "roots": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "dev",
          "ino",
          "registered_at"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096,
            "pattern": "^/(?!/)[^\\u0000-\\u001f\\u007f]*$",
            "description": "Absolute, normalized POSIX path; no '.', '..', '//' or trailing '/'."
          },
          "dev": {
            "type": "integer",
            "minimum": 0
          },
          "ino": {
            "type": "integer",
            "minimum": 0
          },
          "registered_at": {
            "type": "string",
            "format": "date-time",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,6})?Z$"
          }
        },
        "description": "A registered task root; identity is (dev, ino) at registration."
      }
    },
    "artifacts": {
      "type": "array",
      "maxItems": 100000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "dev",
          "ino",
          "class",
          "disposable",
          "recorded_at"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096,
            "pattern": "^/(?!/)[^\\u0000-\\u001f\\u007f]*$",
            "description": "Absolute, normalized POSIX path; no '.', '..', '//' or trailing '/'."
          },
          "dev": {
            "type": "integer",
            "minimum": 0
          },
          "ino": {
            "type": "integer",
            "minimum": 0
          },
          "class": {
            "type": "string",
            "enum": [
              "build-output",
              "test-cache",
              "temp",
              "log",
              "source",
              "draft",
              "deliverable",
              "session-history",
              "model",
              "media",
              "download",
              "worktree",
              "credential",
              "shared-cache",
              "unknown"
            ]
          },
          "disposable": {
            "type": "boolean"
          },
          "recorded_at": {
            "type": "string",
            "format": "date-time",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,6})?Z$"
          }
        },
        "description": "A task-produced artifact; identity is (dev, ino) when recorded."
      }
    }
  },
  "description": "Per-task disposable-artifact manifest. Protected classes may never be marked disposable."
}
