{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/dev-james0723/agent-pooper-scooper/docs/schemas/task-event.v1.schema.json",
  "title": "agent-pooper-scooper/task-event v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "schema_version",
    "event_id",
    "task_id",
    "host",
    "producer",
    "event_type",
    "occurred_at"
  ],
  "properties": {
    "schema": {
      "const": "agent-pooper-scooper/task-event"
    },
    "schema_version": {
      "const": 1
    },
    "event_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@+-]{0,127}$"
    },
    "task_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@+-]{0,127}$"
    },
    "host": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9.-]{0,252}$"
    },
    "producer": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@+-]{0,127}$"
    },
    "event_type": {
      "type": "string",
      "enum": [
        "task.started",
        "task.paused",
        "task.resumed",
        "task.completed",
        "task.failed",
        "task.cancelled"
      ]
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,6})?Z$"
    }
  },
  "description": "Provider-neutral task lifecycle event. A completion event triggers evaluation only, never deletion."
}
