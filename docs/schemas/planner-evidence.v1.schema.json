{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/dev-james0723/agent-pooper-scooper/docs/schemas/planner-evidence.v1.schema.json",
  "title": "agent-pooper-scooper/planner-evidence v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "schema_version",
    "revision",
    "task_id",
    "host",
    "producer",
    "observed_at",
    "expires_at",
    "manifest_digest",
    "task_status",
    "terminal_at",
    "references_complete",
    "references",
    "leases_complete",
    "leases",
    "mounts_complete",
    "mount_points",
    "worktrees_complete",
    "protected_paths",
    "approved_roots"
  ],
  "properties": {
    "schema": {
      "const": "agent-pooper-scooper/planner-evidence"
    },
    "schema_version": {
      "const": 1
    },
    "revision": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@+-]{0,127}$"
    },
    "task_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@+-]{0,127}$"
    },
    "host": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9.-]{0,252}$"
    },
    "producer": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@+-]{0,127}$"
    },
    "observed_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,6})?Z$"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,6})?Z$"
    },
    "manifest_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "task_status": {
      "type": "string",
      "enum": [
        "active",
        "paused",
        "resumable",
        "completed",
        "failed",
        "cancelled",
        "unknown"
      ]
    },
    "terminal_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,6})?Z$"
    },
    "references_complete": {
      "type": "boolean"
    },
    "references": {
      "type": "array",
      "maxItems": 100000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "task_id",
          "state"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096,
            "pattern": "^/(?!/)[^\\u0000-\\u001f\\u007f]*$",
            "description": "Absolute, normalized POSIX path; no '.', '..', '//' or trailing '/'."
          },
          "task_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@+-]{0,127}$"
          },
          "state": {
            "type": "string",
            "enum": [
              "active",
              "paused",
              "resumable",
              "dependent",
              "unknown"
            ]
          }
        }
      }
    },
    "leases_complete": {
      "type": "boolean"
    },
    "leases": {
      "type": "array",
      "maxItems": 100000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "lease_id",
          "state"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096,
            "pattern": "^/(?!/)[^\\u0000-\\u001f\\u007f]*$",
            "description": "Absolute, normalized POSIX path; no '.', '..', '//' or trailing '/'."
          },
          "lease_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@+-]{0,127}$"
          },
          "state": {
            "type": "string",
            "enum": [
              "active",
              "expired",
              "unknown"
            ]
          }
        }
      }
    },
    "mounts_complete": {
      "type": "boolean"
    },
    "mount_points": {
      "type": "array",
      "maxItems": 100000,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 4096,
        "pattern": "^/(?!/)[^\\u0000-\\u001f\\u007f]*$",
        "description": "Absolute, normalized POSIX path; no '.', '..', '//' or trailing '/'."
      }
    },
    "worktrees_complete": {
      "type": "boolean"
    },
    "protected_paths": {
      "type": "array",
      "maxItems": 100000,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 4096,
        "pattern": "^/(?!/)[^\\u0000-\\u001f\\u007f]*$",
        "description": "Absolute, normalized POSIX path; no '.', '..', '//' or trailing '/'."
      }
    },
    "approved_roots": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "dev",
          "ino",
          "uid",
          "approved",
          "approved_by",
          "approved_at",
          "grace_seconds"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096,
            "pattern": "^/(?!/)[^\\u0000-\\u001f\\u007f]*$",
            "description": "Absolute, normalized POSIX path; no '.', '..', '//' or trailing '/'."
          },
          "dev": {
            "type": "integer",
            "minimum": 0
          },
          "ino": {
            "type": "integer",
            "minimum": 0
          },
          "uid": {
            "type": "integer",
            "minimum": 0
          },
          "approved": {
            "type": "boolean"
          },
          "approved_by": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@+-]{0,127}$"
          },
          "approved_at": {
            "type": "string",
            "format": "date-time",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,6})?Z$"
          },
          "grace_seconds": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    }
  },
  "description": "Operator-asserted file snapshot for read-only planning; never execution authority."
}
